<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build with Visual Studio 2019+ / MSBuild (full framework), e.g.
      msbuild MarkdownViewerPlusPlus.sln -restore -p:Configuration=Release -p:Platform=x64

    After compiling, the build
      1. merges all dependencies into the plugin assembly (ILRepack),
      2. adds the unmanaged exports Notepad++ needs (PluginInfrastructure\DllExport\DllExport.ps1),
      3. optionally copies the plugin to Notepad++ (set -p:NppPluginsDir=<Notepad++ plugins folder>),
      4. creates a release zip in Releases\ (Release configuration only).
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>com.insanitydesign.MarkdownViewerPlusPlus</RootNamespace>
    <AssemblyName>MarkdownViewerPlusPlus</AssemblyName>
    <Platforms>x86;x64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Properties\AssemblyInfo.cs uses a wildcard (auto-incremented) version -->
    <Deterministic>false</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <!-- Dependencies are merged into the plugin dll, so they are not needed next to it -->
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <!-- Debugging: start the matching Notepad++ -->
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(Platform)'=='x64'">$(ProgramW6432)\Notepad++\notepad++.exe</StartProgram>
    <StartProgram Condition="'$(Platform)'=='x86'">$(MSBuildProgramFiles32)\Notepad++\notepad++.exe</StartProgram>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlRenderer.WinForms" Version="1.5.1" />
    <PackageReference Include="HtmlRenderer.PdfSharp" Version="1.5.1" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Svg" Version="2.3.0" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.48" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\AboutDialog.cs" SubType="Form" />
    <Compile Update="Forms\AbstractRenderer.cs" SubType="Form" />
    <Compile Update="Forms\MarkdownViewerOptions.cs" SubType="Form" />
    <Compile Update="Forms\MarkdownViewerRenderer.cs" SubType="Form" />
    <Compile Update="Forms\AbstractOptionsPanel.cs" SubType="UserControl" />
    <Compile Update="Forms\OptionsPanelGeneral.cs" SubType="UserControl" />
    <Compile Update="Forms\OptionsPanelHTML.cs" SubType="UserControl" />
    <Compile Update="Forms\OptionsPanelPDF.cs" SubType="UserControl" />
    <Compile Update="Forms\MarkdownViewerHtmlPanel.cs" SubType="Component" />
    <Compile Update="Properties\Resources.Designer.cs" AutoGen="True" DesignTime="True" DependentUpon="Resources.resx" />
    <EmbeddedResource Update="Properties\Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" />
    <EmbeddedResource Include="Resources\MarkdownViewerHTML.css" />
    <None Include="PluginInfrastructure\DllExport\**" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Post-build steps (merge, exports, deploy, zip), imported by the ILRepack package instead of its default merge -->
    <ILRepackTargetsFile>$(MSBuildProjectDirectory)\Plugin.targets</ILRepackTargetsFile>
  </PropertyGroup>

</Project>
